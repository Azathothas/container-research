+// setupRootfsRestricted prepares the rootfs for a restricted runtime
+// (see utils.Restricted): no namespace and no mount(2) syscall is
+// available, so the container will be a plain chroot.
+//
+// What we can still do:
+//   - copy the host's resolv.conf so DNS works
+//   - ensure /tmp, /run, /dev and /etc exist in the rootfs
+//   - provide configured volumes as snapshot copies
+//   - write /run/.containerenv (same as the normal path)
+//
+// What is impossible in such runtimes and thus skipped:
+//   - /proc, /sys, /dev mounts (and device nodes: mknod(2) is denied
+//     alongside mount(2)), so those directories stay as shipped in the
+//     image
+//   - tmpfs on /tmp and private cgroup/pts instances.
+func setupRootfsRestricted(path string, conf utils.Config) error {
+	logging.LogWarning("restricted runtime: setting up plain-chroot rootfs (no mounts)")
+
+	for _, dir := range []string{"tmp", "run", "dev", "etc"} {
+		if err := os.MkdirAll(filepath.Join(path, dir), 0o755); err != nil {
+			return fmt.Errorf("error creating %s in rootfs: %w", dir, err)
+		}
+	}
+
+	// DNS: plain copy instead of a bind mount. Only when the rootfs does not
+	// already carry one: a host resolv.conf pointing at a loopback resolver
+	// (eg. 127.0.0.53) is unusable from inside the container, and the
+	// operator may have installed a working one.
+	if _, err := os.Lstat(filepath.Join(path, "etc", "resolv.conf")); err != nil {
+		if hostResolv, rerr := fileutils.ReadFile("/etc/resolv.conf"); rerr == nil {
+			if werr := fileutils.WriteFile(
+				filepath.Join(path, "etc", "resolv.conf"), hostResolv, 0o644); werr != nil {
+				logging.LogWarning("restricted runtime: could not set up resolv.conf: %v", werr)
+			}
+		}
+	}
+
+	// Device nodes cannot be created (mknod is denied alongside mount), and
+	// no /dev can be bind-mounted in. A regular-file /dev/null stand-in keeps
+	// shell redirections and tooling that opens /dev/null for writing
+	// working; reads return EOF. This is a compatibility shim, not a device.
+	if _, err := os.Lstat(filepath.Join(path, "dev", "null")); err != nil {
+		if f, err := os.OpenFile(
+			filepath.Join(path, "dev", "null"), os.O_CREATE|os.O_WRONLY, 0o666); err == nil {
+			_ = f.Close()
+		}
+	}
+
+	// Volumes: no bind mounts available, take a snapshot copy instead.
+	for _, volume := range conf.Mounts {
+		if volume == "" {
+			continue
+		}
+
+		// --mount type=...,source=...,destination=... syntax
+		if strings.Contains(volume, "type=") {
+			var source, destination string
+
+			for _, field := range strings.Split(volume, ",") {
+				switch {
+				case strings.HasPrefix(field, "source="):
+					source = strings.TrimPrefix(field, "source=")
+				case strings.HasPrefix(field, "destination="):
+					destination = strings.TrimPrefix(field, "destination=")
+				}
+			}
+
+			if destination != "" {
+				if err := copyIntoRootfs(source, filepath.Join(path, destination)); err != nil {
+					logging.LogWarning("restricted runtime: volume %s unavailable: %v", volume, err)
+				}
+			}
+
+			continue
+		}
+
+		// src:dest or anonymous dest syntax
+		parts := strings.Split(volume, ":")
+
+		switch {
+		case len(parts) >= 2:
+			if err := copyIntoRootfs(parts[0], filepath.Join(path, parts[1])); err != nil {
+				logging.LogWarning("restricted runtime: volume %s unavailable: %v", volume, err)
+			}
+		default:
+			// anonymous volume: just a directory inside the rootfs
+			if err := os.MkdirAll(filepath.Join(path, volume), 0o755); err != nil {
+				logging.LogWarning("restricted runtime: volume %s unavailable: %v", volume, err)
+			}
+		}
+	}
+
+	logging.LogDebug("populating /run/.containerenv")
+
+	// setting this file ensures compatibility and gives back some info
+	infoFile, err := os.Create(filepath.Join(path, "/run/.containerenv"))
+	if err != nil {
+		logging.LogDebug("error: %+v", err)
+
+		return err
+	}
+
+	defer func() { _ = infoFile.Close() }()
+
+	info := fmt.Sprintf(`engine="%s"
+name="%s"
+id="%s"
+image="%s"
+imageid="%s"
+`, "lilipod-"+constants.Version, conf.Names, GetID(conf.Names), conf.Image, imageutils.GetID(conf.Image))
+
+	_, err = infoFile.WriteString(info)
+	if err != nil {
+		logging.LogDebug("error: %+v", err)
+
+		return err
+	}
+
+	return nil
+}
+
+// copyIntoRootfs will copy input src (file or directory) into dest,
+// creating parents as needed. Used by the restricted-runtime volume
+// handling, where real bind mounts are impossible.
+func copyIntoRootfs(src string, dest string) error {
+	if src == "" {
+		return os.MkdirAll(dest, 0o755)
+	}
+
+	info, err := os.Stat(src)
+	if err != nil {
+		return err
+	}
+
+	if err := os.MkdirAll(filepath.Dir(dest), 0o755); err != nil {
+		return err
+	}
+
+	if info.IsDir() {
+		return copyDirIntoRootfs(src, dest)
+	}
+
+	return fileutils.CopyFileContainer(src, dest)
+}
+
+// copyDirIntoRootfs will recursively copy src dir into dest.
+func copyDirIntoRootfs(src string, dest string) error {
+	entries, err := os.ReadDir(src)
+	if err != nil {
+		return err
+	}
+
+	if err := os.MkdirAll(dest, 0o755); err != nil {
+		return err
+	}
+
+	for _, entry := range entries {
+		srcEntry := filepath.Join(src, entry.Name())
+		destEntry := filepath.Join(dest, entry.Name())
+
+		if entry.IsDir() {
+			if err := copyDirIntoRootfs(srcEntry, destEntry); err != nil {
+				return err
+			}
+
+			continue
+		}
+
+		if err := fileutils.CopyFileContainer(srcEntry, destEntry); err != nil {
+			// symlinks and special files are copied on a best-effort basis
+			logging.LogDebug("restricted runtime: skipping %s: %v", srcEntry, err)
+		}
+	}
+
+	return nil
+}
